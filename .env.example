# ==============================================================================
# AskWiki - Production Agentic RAG Configuration
# ==============================================================================

# LLM Provider Options: "ollama", "openai", "anthropic", or "demo" (offline synthesizer)
MODEL_PROVIDER=ollama
CHAT_MODEL=llama3.2:3b
TEMPERATURE=0.1

# Ollama Endpoint
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI Configuration (if using MODEL_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Anthropic Configuration (if using MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=anthropic-...

# Embeddings: "auto", "ollama", "openai", or "local" (deterministic 384-dim normalized)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=mxbai-embed-large

# ChromaDB Persistent Storage
DATABASE_LOCATION=chroma_db
COLLECTION_NAME=rag_data

# Wikipedia User Agent (Wikimedia policy compliance)
WIKIPEDIA_USER_AGENT=AskWiki/2.0 (enterprise-agentic-rag; +https://github.com/datawithshoaib/AskWiki)

# Optional: Bright Data Datasets API
BRIGHTDATA_API_KEY=
DATASET_STORAGE_FOLDER=datasets/
SNAPSHOT_STORAGE_FILE=snapshot.txt
